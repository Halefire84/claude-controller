<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:title="Do not contact"
        app:titleTextColor="@color/ink"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <EditText
            android:id="@+id/dncInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Business name"
            android:contentDescription="Business name to add to the do-not-contact list"
            android:inputType="textCapWords"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDncAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add"
            android:contentDescription="Add business to the do-not-contact list" />
    </LinearLayout>

    <ListView
        android:id="@+id/dncList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Do-not-contact list. Tap a name to remove it."
        android:divider="@color/line"
        android:dividerHeight="1dp" />

</LinearLayout>
