<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg"
            app:title="Controller"
            app:titleTextColor="@color/ink"
            app:menu="@menu/menu_main" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            <!-- Section: Queues -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUEUES"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <include layout="@layout/job_card"
                android:id="@+id/cardQueueOutreach" />

            <include layout="@layout/job_card"
                android:id="@+id/cardQueueReceptionist" />

            <include layout="@layout/job_card"
                android:id="@+id/cardQueueSiteBuild" />

            <include layout="@layout/job_card"
                android:id="@+id/cardQueueDailyOps" />

            <!-- Section: Outreach -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OUTREACH"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <include layout="@layout/job_card"
                android:id="@+id/cardFindProspects" />

            <include layout="@layout/job_card"
                android:id="@+id/cardDraftEmail" />

            <include layout="@layout/job_card"
                android:id="@+id/cardCheckInbox" />

            <!-- Section: Build -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BUILD"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <include layout="@layout/job_card"
                android:id="@+id/cardBuildDemo" />

            <include layout="@layout/job_card"
                android:id="@+id/cardAuditSite" />

            <!-- Section: Ops -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPS"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <include layout="@layout/job_card"
                android:id="@+id/cardRunRunbook" />

            <include layout="@layout/job_card"
                android:id="@+id/cardCustomJob" />

            <!-- Section: Receptionist -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECEPTIONIST"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <include layout="@layout/job_card"
                android:id="@+id/cardReceptionistBuildProfile" />

            <include layout="@layout/job_card"
                android:id="@+id/cardReceptionistDraftReply" />

            <include layout="@layout/job_card"
                android:id="@+id/cardReceptionistTest" />

            <include layout="@layout/job_card"
                android:id="@+id/cardReceptionistPitch" />

            <include layout="@layout/job_card"
                android:id="@+id/cardReceptionistOnboard" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
